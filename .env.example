# ModelScope API Key (Optional, but recommended for some features)
# Get it from https://modelscope.cn
MODELSCOPE_API_KEY=your_api_key_here

# 容器内的下载目录（代码读这个）
DOWNLOAD_DIR=/models

# 宿主机的实际下载目录，挂载到容器的 /models
MODEL_HOST_DIR=/opt/hdd/my/models

# Port to run the web app
PORT=8000

# 状态存储（Redis）。docker compose 内部服务名默认是 redis
REDIS_URL=redis://redis:6379/0

# 容器运行身份；改成自己的 uid/gid 可让下载文件归属当前用户
HOST_UID=1000
HOST_GID=1000
